                        ["\tD2 - não avaliados", sanitize("<%= relUC[0].estudD2 %>"), "","", Dperc22, "(D2/A)*100" ],
                        ["E - Distribuição da CLASSIFICAÇÃO dos ESTUDANTES APROVADOS:", "", "","", "", "" ],
                        ["\tE1 - Estudantes com notas entre 10 e 13 valores", sanitize("<%= relUC[0].estudE1 %>"), Eperc11,"(E1/C)*100", Eperc12, "(E1/A)*100" ],
                        ["\tE2 - Estudantes com notas entre 14 e 15 valores", sanitize("<%= relUC[0].estudE2 %>"), Eperc21,"(E2/C)*100", Eperc22, "(E2/A)*100" ],
                        ["\tE3 - Estudantes com notas entre 16 e 20 valores", sanitize("<%= relUC[0].estudE3 %>"), Eperc31,"(E3/C)*100", Eperc32, "(E3/A)*100" ],
                        ["F - MÉDIA GLOBAL DA UC", "", "",calculo, "", "" ]]

        doc.autoTable({
            head: [header11],
            body: data11,
            margin: { right: 14, left: 14, top: 40 },

            // ⭐ STYLE OVERRIDES ⭐
            styles: {
                halign: 'center',       // center text
                valign: 'middle',
                textColor: [0, 0, 0],   // black text
                fillColor: false,       // no background color
                
            },

            headStyles: headerTable,

            bodyStyles: bodyStyles,

            theme: 'plain',              // ensures full bordered table
            didDrawTable: function(data) {
                // Extra spacing after table
                doc.setY(doc.lastAutoTable.finalY + 15);
            }
        });

        doc.addPage();

        var header12 = ['4 - Comentários, críticas e conclusões'];
        var data12 = [[sanitize(`<%= relUC[0].comentarios %>`)]]
        doc.autoTable({
            head: [header12],
            body: data12,
            margin: { right: 14, left: 14, top: 40 },
            showHead: 'firstPage',

            // ⭐ STYLE OVERRIDES ⭐
            styles: {
                halign: 'center',       // center text
                valign: 'middle',
                textColor: [0, 0, 0],   // black text
                fillColor: false,       // no background color
                
            },

            headStyles: headerTitle,
            bodyStyles: bodyStyles,

            theme: 'plain',              // ensures full bordered table
            didDrawTable: function(data) {
                // Extra spacing after table
                doc.setY(doc.lastAutoTable.finalY + 15);
            }
        });


        addFooters(doc);

        doc.save("RUC_<%= relUC[0].uc %>_<%= relUC[0].anoLetivo %>.pdf");   
        
        setTimeout(function (){

            window.close();
                    
        }, 1000);
    }


</script>


