                            <td><input id="dtaAvalCont7" name="dtaAvalCont7" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].dtaAvalCont7 : ''%>"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-6">
                <table class="table table-striped table-sm table-hover">
                    <thead class="table-dark align-middle">
                        <tr>
                            <th>Avaliação final</th>
                            <th>Datas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Exame da época normal</td>
                            <td><input id="dtaAvalEpNorm" name="dtaAvalEpNorm" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].dtaAvalFimEN : ''%>"></td>
                        </tr>
                        <tr>
                            <td>Exame da época extraordinária</td>
                            <td><input id="dtaAvalEpExtra" name="dtaAvalEpExtra" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].dtaAvalFimEE : ''%>"></td>
                        </tr>
                        <tr>
                            <td>Exame da época especial estudantes estatuto trab.-estudante</td>
                            <td><input id="dtaAvalEpTrabEst" name="dtaAvalEpTrabEst" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].dtaAvalFimET : ''%>"></td>
                        </tr>
                        <tr>
                            <td>Exame da época especial para estudantes finalistas</td>
                            <td><input id="dtaAvalEpFin" name="dtaAvalEpFin" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].dtaAvalFimEF : ''%>"></td>
                        </tr>
                        
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <h5>3- Análise estatística</h5>
            </div>
            <table class="table table-striped table-sm table-hover">
                <thead class="table-dark align-middle">
                    <tr>
                        <th>Distribuição dos estudantes</th>
                        <th style="max-width: 50px;">Nº de estudantes</th>
                    
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>A - Estudantes INSCRITOS na UC</b> (ver pauta dos serviços académicos)</td>
                        <td style="max-width: 50px;"><input id="estudA" name="estudA" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudA : 0 %>"></td>
                    </tr>
                    <tr>
                        <td><b>B - Estudantes AVALIADOS</b> (em pelo menos um dos momentos de avaliação)</td>
                        <td style="max-width: 50px;"><input id="estudB" name="estudB" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudB : 0 %>"></td>
                    </tr>
                    <tr>
                        <td><b>C - Estudantes APROVADOS:</b></td>
                        <td style="max-width: 50px;"><input id="estudC" name="estudC" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;C1 - em avaliação contínua;</td>
                        <td style="max-width: 50px;"><input id="estudC1" name="estudC1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC1 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;C2 - em avaliação final: época normal;</td>
                        <td style="max-width: 50px;"><input id="estudC2" name="estudC2" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC2 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;C3 - em avaliação final: época extraordinária;</td>
                        <td style="max-width: 50px;"><input id="estudC3" name="estudC3" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC3 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;C4 - em avaliação final: época especial para estudantes finalistas;</td>
                        <td style="max-width: 50px;"><input id="estudC4" name="estudC4" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC4 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;C5 - em avaliação final: época especial para estud/ estatuto trab. estudante;</td>
                        <td style="max-width: 50px;"><input id="estudC5" name="estudC5" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudC5 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td><b>D - Estudantes REPROVADOS</b></td>
                        <td style="max-width: 50px;"><input id="estudD" name="estudD" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudD : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;D1 - avaliados;</td>
                        <td style="max-width: 50px;"><input id="estudD1" name="estudD1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudD1 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;D2 - não avaliados;</td>
                        <td style="max-width: 50px;"><input id="estudD2" name="estudD2" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudD2 : 0 %>"></td>
                    </tr>
                    <tr>
                        <td><b>E - Distribuição da CLASSIFICAÇÃO dos ESTUDANTES APROVADOS:</b></td>
                        <td style="max-width: 50px;"><input id="estudE" name="estudE" class="form-control form-control-sm" disabled></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;E1 - estudantes com notas entre 10 e 13 valores;</td>
                        <td style="max-width: 50px;"><input id="estudE1" name="estudE1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudE1 : 0 %>" readonly></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;E2 - estudantes com notas entre 14 e 15 valores;</td>
                        <td style="max-width: 50px;"><input id="estudE2" name="estudE2" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudE2 : 0 %>" readonly></td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;E3 - estudantes com notas entre 16 e 20 valores;</td>
                        <td style="max-width: 50px;"><input id="estudE3" name="estudE3" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].estudE3 : 0 %>" readonly></td>
                    </tr>
                </tbody>
            </table>
            <div class="col-3">
                <table class="table table-striped table-sm table-hover">
                    <thead class="table-dark align-middle">
                        <tr>
                            <th>Nota</th>
                            <th>Nº Estudantes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>10</td>
                            <td><input id="nota10" name="nota10" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota10 : 0 %>" oninput="calculateRatioE1()"></td>
                        </tr>
                        <tr>
                            <td>11</td>
                            <td><input id="nota11" name="nota11" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota11 : 0 %>" oninput="calculateRatioE1()"></td>
                        </tr>
                        <tr>
                            <td>12</td>
                            <td><input id="nota12" name="nota12" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota12 : 0 %>" oninput="calculateRatioE1()"></td>
                        </tr>
                        <tr>
                            <td>13</td>
                            <td><input id="nota13" name="nota13" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota13 : 0 %>" oninput="calculateRatioE1()"></td>
                        </tr>
                        <tr>
                            <td>14</td>
                            <td><input id="nota14" name="nota14" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota14 : 0 %>" oninput="calculateRatioE2()"></td>
                        </tr>
                        <tr>
                            <td>15</td>
                            <td><input id="nota15" name="nota15" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota15 : 0 %>" oninput="calculateRatioE2()"></td>
                        </tr>
                        <tr>
                            <td>16</td>
                            <td><input id="nota16" name="nota16" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota16 : 0 %>" oninput="calculateRatioE3()"></td>
                        </tr>
                        <tr>
                            <td>17</td>
                            <td><input id="nota17" name="nota17" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota17 : 0 %>" oninput="calculateRatioE3()"></td>
                        </tr>
                        <tr>
                            <td>18</td>
                            <td><input id="nota18" name="nota18" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota18 : 0 %>" oninput="calculateRatioE3()"></td>
                        </tr>
                        <tr>
                            <td>19</td>
                            <td><input id="nota19" name="nota19" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota19 : 0 %>" oninput="calculateRatioE3()"></td>
                        </tr>
                        <tr>
                            <td>20</td>
                            <td><input id="nota20" name="nota20" class="form-control form-control-sm number" value="<%= relUC[0] ? relUC[0].nota20 : 0 %>" oninput="calculateRatioE3()"></td>
                        </tr>
                    </tbody>
                </table>
                <script>
                    function calculateRatioE1() {
                        let a = parseFloat($("#nota10").val());
                        let b = parseFloat($("#nota11").val());
                        let c = parseFloat($("#nota12").val());
                        let d = parseFloat($("#nota13").val());

                        if (!isNaN(a) && !isNaN(b) && !isNaN(c) && !isNaN(d) ) {
                            $("#estudE1").val(a+b+c+d);
                        } else {
                            $("#estudE1").val("");
                        }
                    }
                    function calculateRatioE2() {
                        let a = parseFloat($("#nota14").val());
                        let b = parseFloat($("#nota15").val());
                        if (!isNaN(a) && !isNaN(b) ) {
                            $("#estudE2").val(a+b);
                        } else {
                            $("#estudE2").val("");
                        }
                    }

                    function calculateRatioE3() {
                        let a = parseFloat($("#nota16").val());
                        let b = parseFloat($("#nota17").val());
                        let c = parseFloat($("#nota18").val());
                        let d = parseFloat($("#nota19").val());
                        let e = parseFloat($("#nota20").val());

                        if (!isNaN(a) && !isNaN(b) && !isNaN(c) && !isNaN(d) && !isNaN(e) ) {
                            $("#estudE3").val(a+b+c+d+e);
                        } else {
                            $("#estudE3").val("");
                        }
                    }
                </script>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <h5>4- Comentários, críticas e conclusões</h5>
                <div class="row justify-content-between">
                    <div class="col-auto me-auto">
                        <span style="font-size: 10 !important; color: rgb(104, 104, 104);">
                           A título de exemplo: comente, acerca da carga horária e funcionamento da UC é ou não a mais adequada; apresente igualmente uma análise crítica acerca dos resultados alcançados, atendendo ao sucesso escolar; se for o caso, apresente críticas construtivas e pontos de melhoria (adequação dos conteúdos, recursos didáticos, metodologias de avaliação); a título de conclusão, apresente ainda uma breve síntese e se for o caso, uma proposta enquanto plano de ação para melhorias a implementar no próximo ano letivo. 
                        </span>
                    </div>
                    <div class="col-auto me-auto"><span style="font-size: 10 !important; color: rgb(104, 104, 104);">(Máximo 15000 caracteres)</span></div>
                    <div class="col-auto"><span id="lbObsCount" class="">0</span></div>
                </div>
                
            </div>
            <div class="col-12">
                <textarea id="comentarios" name="comentarios" maxlength="15001" rows="10" class="form-control" onchange="checkNumberOfChars(this);" onpaste="checkNumberOfChars(this);" onkeyup="checkNumberOfChars(this);" uidestino="lbObsCount" uimaxlength="15000" ><%= relUC[0] ? relUC[0].comentarios : ''%></textarea>
            </div>
        </div>
        <div class="row my-3">
            <div class="col-4">
                <button class="btn btn-sm btn-primary w-100" type="sumbit">Gravar</button>
            </div>
            <div class="col-4">
                <a href="/pdfRelUc/<%= uc[0].idfucs %>/<%= uc[0].nomeUCPt %>/<%= anoLetivo %>/<%= uc[0].nomeCE %>" class="btn btn-sm btn-danger w-100" target="_blank">Criar PDF</a>
            </div>
            <div class="col-4">
                <a href="/pdfSendRUC/<%= relUC[0] ? relUC[0].idrelUC : 0 %>" class="btn btn-sm btn-danger w-100" target="_blank">Submeter RUC</a>
            </div> 
        </div>
    </form>
</div>



<%- include('partials/footer') %>