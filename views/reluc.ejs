                        <td><input id="horasEdoc1" name="horasEdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1E : ''%>"/></td>
                        <td><input id="horasOTdoc1" name="horasOTdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1OT : ''%>"/></td>
                        <td><input id="horasOdoc1" name="horasOdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1O : ''%>"/></td>
                        <td><input id="aulasPrev1" name="aulasPrev1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1AulasPrev : ''%>" oninput="calculateRatio1()"/></td>
                        <td><input id="aulasLecio1" name="aulasLecio1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1AulasLec : ''%>" oninput="calculateRatio1()"/></td>
                        <td><input id="percAulasDadas1" name="percAulasDadas1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1PrecAulas : ''%>" readonly/></td>
                    </tr>
                    <script>
                        $(document).on('input', `
                            #horasTdoc1,
                            #horasTPdoc1,
                            #horasPLdoc1,
                            #horasTCdoc1,
                            #horasSdoc1,
                            #horasEdoc1,
                            #horasOTdoc1,
                            #horasOdoc1
                        `, function () {
                            calculateAulasPrev1();
                        });
                        function calculateAulasPrev1(){
                            let total = 0;

                            const fields = [
                                '#horasTdoc1',
                                '#horasTPdoc1',
                                '#horasPLdoc1',
                                '#horasTCdoc1',
                                '#horasSdoc1',
                                '#horasEdoc1',
                                '#horasOTdoc1',
                                '#horasOdoc1'
                            ];

                            fields.forEach(function(selector) {
                                let val = parseFloat($(selector).val()) || 0;
                                total += val;
                            });

                            $('#aulasPrev1').val(total);
                        }
                        function calculateRatio1() {
                            let a = parseFloat($("#aulasPrev1").val());
                            let b = parseFloat($("#aulasLecio1").val());

                            if (!isNaN(a) && !isNaN(b) && b !== 0) {
                                $("#percAulasDadas1").val((b / a * 100).toFixed(2));
                            } else {
                                $("#percAulasDadas1").val("");
                            }
                        }
                    </script>
