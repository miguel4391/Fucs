                        <!--<td><input id="nrTurmas1" name="nrTurmas1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].nrTurmDoc1 : ''%>"></td>-->
                        <td><input id="horasTdoc1" name="horasTdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1T : ''%>"/></td>
                        <td><input id="horasTPdoc1" name="horasTPdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1TP : ''%>"/></td>
                        <td><input id="horasPLdoc1" name="horasPLdoc1" class="form-control form-control-sm" value="<%= relUC[0] ? relUC[0].doc1PL : ''%>"/></td>
