<%- include('partials/header') %>
<script>
    $(document).on('click', '.addDoc', function () {
        const modal = new bootstrap.Modal(document.getElementById('docenteModal'));
        clearModal();
        $("#modalTitle").text("Adicionar Docente");
       
        $('#idFucModal').val($(this).data('id'));
        $('#nomeUcModal').html($(this).data('nomefuc') + "<p>Adicionar outro docente</p>")
        $('#doc2Modal').val($(this).data('doc2'));
        $('#doc3Modal').val($(this).data('doc3'));
        $('#doc4Modal').val($(this).data('doc4'));
        $('#doc5Modal').val($(this).data('doc5'));
        $('#doc6Modal').val($(this).data('doc6'));
        $('#doc7Modal').val($(this).data('doc7'));
        $('#doc8Modal').val($(this).data('doc8'));
        $('#doc9Modal').val($(this).data('doc9'));
        $('#doc10Modal').val($(this).data('doc10'));
        modal.show();
        getDocente();
    })
    $(document).on('click', '.saveDoc', function () {
        $.post('/saveDocentes', {
            idUc: $('#idFucModal').val(),
            doc2: $('#doc2').val(),
            doc3: $('#doc3').val(),
            doc4: $('#doc4').val(),
            doc5: $('#doc5').val(),
            doc6: $('#doc6').val(),
            doc7: $('#doc7').val(),
            doc8: $('#doc8').val(),
            doc9: $('#doc9').val(),
            doc10: $('#doc10').val()
        })
        .done(function () {
            $('#docenteModal').modal('hide');
        });

    });

    function clearModal(){
        $('#doc2Modal').val("");
        $('#doc3Modal').val("");
        $('#doc4Modal').val("");
        $('#doc5Modal').val("");
        $('#doc6Modal').val("");
        $('#doc7Modal').val("");
        $('#doc8Modal').val("");
        $('#doc9Modal').val("");
        $('#doc10Modal').val("");
        $('#doc2').val(0);
        $('#doc3').val(0);
        $('#doc4').val(0);
        $('#doc5').val(0);
        $('#doc6').val(0);
        $('#doc7').val(0);
        $('#doc8').val(0);
        $('#doc9').val(0);
        $('#doc10').val(0);
    }
    function getDocente(){
        for(let i = 2; i <= 10; i++) {
            if($('#doc' + i + 'Modal').val()){
                $('#doc' + i).val($('#doc' + i + 'Modal').val());
            }
        }
    }
</script>
