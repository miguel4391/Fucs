<%- include('partials/header') %>
<style>
    .invisible{
        display: none;
    }
</style>
<div class="container mt-5">
	<div class="row">
        <div class="col-xl-8">
            <div class="row mt-5">
                <div class="row mb-3">	
                    <h1>Eliminar FUC - Ficha de Unidade Curricular</h1> 
                    <h1><%= ano.replace('_','/') %></h1>
                </div>
                <div class="col-12 mt-5">
                    <label for="curso" class="form-label">Selecionar o Ciclo de Estudos</label>
                    <select id="curso" name="curso" class="form-select">
                        <option value="0">----------------------------------------</option>
                        <% cursos.forEach((curso) => { %>
                            <option value="<%= curso.sigla %>"><%= curso.nomeExt %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <script>
                $('#curso').on("change", function(){
                    $("#fuc").children().remove();
                    let ce = $(this).val();
                    if(typeof ce === "string" && ce != null && ce.length > 0){
                        
                        $.ajax({
                            type: 'GET',
                            url:'https://fucs.uatlantica.pt/getUC/' + ce+ '/<%= ano.replace("/", "_") %>',
                            dataType: 'json'
                        })
                        .done((data)=>{
                            let listItems = '<option value="0">----------------------------------------</option>';
                            $.each(data, (key, value) =>{
                                listItems += '<option value=' + value['IdFuc'] + '>' + value['UC'] + '</option>'
                            })
                            $("#fuc").append(listItems);
                        })
                        .fail((jqXHR, textStatus, err) => {
                            console.log('AJAX error response: ', err);
                        })
                    }
                })
            </script>
            <div class="row mt-5">
                <div class="col-12 mt-5">
                    <label for="fuc" class="form-label">Selecionar a Unidade Curricular</label>
                    <select id="fuc" name="fuc"  class="form-select">
                        <option value="0">----------------------------------------</option>
                    </select>
                    <script>
                        $('#fuc').on("change", function(){
                            let fuc = $(this).val();
                            if(fuc != null){
                                if(fuc != '0') {

                                    $.ajax({
                                        type: 'GET',
                                        url:'https://fucs.uatlantica.pt/getFucDel/' + fuc,
                                        dataType: 'json'
                                    })
                                    .done((data)=>{
                                        $("#sbmt").removeClass("invisible");
                                        let listItems ="";
                                        $("#tbody").empty();
                                        $.each(data, (key, value) =>{
                                            listItems += "<tr><td>" + value['idfucs'] + "</td><td>" + value['dtaRevFuc'] + "</td><td>" + value['nomeUCPt'] + "</td><td>" + value['curso_sigla'] + "</td><td><form action='/delFuc/" + value['idfucs'] + "' method='post'><button class='btn btn-sm-outline' type='submit' onclick='show_alert()'><i class='fa-solid fa-trash'></i></button></form>" + "</td></tr>"
                                        })
                                        $("#tbody").append(listItems);
                                    })
                                    .fail((jqXHR, textStatus, err) => {
                                        console.log('AJAX error response: ', err);
                                    })
                                }
                                else{ 
                                    $("#sbmt").addClass("invisible");}

                                $("#btnSbmt").attr("href", "/getFuc/" + fuc)
                            }
                        })
                    </script>
                    <script>
                        function show_alert() {
                            if(!confirm("Tem a certeza que pretende apagar? \nEsta acção não pode ser revertida.")) {
                                return false;
                            }
                            this.form.submit();
                        }
                    </script>
                </div>
            </div>
            <div id="sbmt" class="row mt-5 invisible">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Data</th>
                            <th>Nome</th>
                            <th>CE</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>