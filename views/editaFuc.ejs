    <div class="container">
        <form method='post' action='../editaUc'>
            <input type="hidden" id="codFuc" name="codFuc" value="<%= fuc[0].idfucs %>">
            <div class="row mt-5">
                <div class="col-12">
                    <table>
                        <thead>	
                            <tr><th><label class="mx-3">Designação da Unidade Curricular</label></th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="form-floating">
                                    <% if(role=="gestor"){ %>
                                        <input type="text" class="form-control form-control-sm" id="ptTitle" name="ptTitle" placeholder="nomePt" value="<%= fuc[0].nomeUCPt %>" >
                                    <% }else{ %>
                                        <input type="text" class="form-control form-control-sm" id="ptTitle" name="ptTitle" placeholder="nomePt" value="<%= fuc[0].nomeUCPt %>"  readonly>
                                    <% } %>
                                        <label for="ptTitle">PT:</label>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-floating mb-3">
                                    <% if(role=="gestor"){ %>
                                        <input type="text" class="form-control form-control-sm" id="enTitle" name="enTitle" placeholder="nomePt" value="<%= fuc[0].noemUCEn %>">
                                    <% }else{ %>
                                        <input type="text" class="form-control form-control-sm" id="enTitle" name="enTitle" placeholder="nomePt" value="<%= fuc[0].noemUCEn %>"  readonly>
                                    <% } %>
                                        <label for="enTitle">EN:</label>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12">
                    <table>
                        <thead>
                            <tr><th><label class="mx-3">Designação do Ciclo de Estudos</label></th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                <% if(role=="gestor"){ %>
                                    <input type="text" class="form-control form-control-sm" id="nomeCe" name="nomeCe" placeholder="nomeCe" value="<%= fuc[0].nomeCE %>">
                                <% }else{ %>
                                    <input type="text" class="form-control form-control-sm" id="nomeCe" name="nomeCe" placeholder="nomeCe" value="<%= fuc[0].nomeCE %>" readonly>
                                <% } %>
                                    <input type="hidden" class="form-control form-control-sm" id="ceSigla" name="ceSigla" placeholder="ceSigla" value="<%= fuc[0].curso_sigla %>">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12">
                    <table>
                        <thead>
                            <tr>
                                <th>Código UC</th>
                                <th>Sigla da área científica</th>
                                <th>Ano</th>
                                <th>Semestre</th>
                                <th>Escolher</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="text" class="form-control form-control-sm" id="codUC" name="codUC" placeholder="Não preencher" disabled="disabled"></td>
                                <td>
                                <% if(role=="gestor"){ %>
                                    <input type="text" class="form-control form-control-sm" id="sigla" name="sigla" value="<%= fuc[0].areaCienc %>">
                                <% }else{ %>
                                    <input type="text" class="form-control form-control-sm" id="sigla" name="sigla" value="<%= fuc[0].areaCienc %>" readonly>
                                <% } %>
                                </td>
                                <td>
                                <% if(role=="gestor"){ %>
                                    <select id="ano" name="ano" class="form-select form-select-sm">
                                <% }else{ %>
                                    <select id="ano" name="ano" class="form-select form-select-sm locked-select">
                                <% } %>
                                        <% if(fuc[0].ano=="1º") {%>
                                            <option value="1º" selected>1º</option>
                                            <option value="2º">2º</option>
                                            <option value="3º">3º</option>
                                            <option value="4º">4º</option>
                                        <% }else if(fuc[0].ano=="2º") {%>
                                            <option value="1º">1º</option>
                                            <option value="2º" selected>2º</option>
                                            <option value="3º">3º</option>
                                            <option value="4º">4º</option>
                                        <% }else if(fuc[0].ano=="3º") {%>
                                            <option value="1º">1º</option>
                                            <option value="2º">2º</option>
                                            <option value="3º" selected>3º</option>
                                            <option value="4º">4º</option>
                                        <% }else if(fuc[0].ano=="4º") {%>
                                            <option value="1º">1º</option>
                                            <option value="2º">2º</option>
                                            <option value="3º">3º</option>
                                            <option value="4º" selected>4º</option>
                                        <% } %>
                                    </select>
                                </td>
                                <td>
                                <% if(role=="gestor"){ %>
                                    <select id="semestre" name="semestre" class="form-select form-select-sm">
                                <% }else{ %>
                                    <select id="semestre" name="semestre" class="form-select form-select-sm locked-select">
                                <% } %>
                                        <% if(fuc[0].semestre=="1º") {%>
                                            <option value="1º" selected>1º</option>
                                            <option value="2º">2º</option>
                                        <% }else if(fuc[0].semestre=="2º") {%>
                                            <option value="1º">1º</option>
                                            <option value="2º" selected>2º</option>
                                        <% } %>
                                    </select>
                                </td>
                                <td>
                                <% if(role=="gestor"){ %>
                                    <select id="caracter" name="caracter" class="form-select form-select-sm">
                                <% }else{ %>
                                    <select id="caracter" name="caracter" class="form-select form-select-sm locked-select">
                                <% } %>
                                        <% if(fuc[0].regime =="obrigatoria") {%>
                                            <option value="obrigatoria" selected >Obrigatória</option>
                                            <option value="optativa">Optativa</option>    
                                        <% }else{ %>
                                            <option value="obrigatoria">Obrigatória</option>
                                            <option value="optativa" selected >Optativa</option>
                                        <% } %>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12">
                    <table>
                        <thead>
                            <tr>
                                <th>Duração</th>
                                <th>Nº horas de trabalho</th>
