            <div class="row mt-5 mb-5">
                <div class="col-12">
                    <table>
                        <tr>
                            <td colspan="2">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="respFuc" name="respFuc" placeholder="respFuc" value="<%= fuc[0].docRespFuc %>" <% if(fuc[0].editavel == 1){%> readonly <% } %>>
                                    <label for="respFuc">Docente da UC Responsável pela revisão desta FUC:</label>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="coordCEResp" name="coordCEResp" placeholder="coordCEResp" value="<%= fuc[0].coordCe %>" <% if(fuc[0].editavel == 1){%> readonly <% } %>>
                                    <label for="coordCEResp">Coordenador do CE responsável pela validação:</label>
                                </div>
                            </td>
                            <td class="px-3">
                                <span style="display: none;"<% if(role == "docente"){%>style="display: none;" <% } %>>
                                    <style>
                                        .btn-toggle {
                                            margin: 0 4rem;
                                            padding: 0;
                                            position: relative;
                                            border: none;
                                            height: 1.5rem;
                                            width: 3rem;
                                            border-radius: 1.5rem;
                                            color: #6b7381 !important;
                                            background: #bdc1c8 !important;
                                        }
                                        .btn-toggle:focus, .btn-toggle:focus.active, .btn-toggle.focus, .btn-toggle.focus.active {
                                            outline: none;
                                        }
                                        .btn-toggle:before, .btn-toggle:after {
                                            line-height: 1.5rem;
                                            width: 4rem;
                                            text-align: center;
                                            font-weight: 900;
                                            font-size: .7rem;
                                            text-transform: uppercase;
                                            letter-spacing: 1px;
                                            position: absolute;
                                            bottom: 0;
                                            transition: opacity .25s;
                                        }
                                        .btn-toggle:before {
                                            margin-right: 2px;
                                            content: 'Bloqueado';
                                            left: -5rem;
                                        }
                                        .btn-toggle:after {
                                            margin-left: 2px;
                                            content: 'Desbloqueado';
                                            right: -5rem;
                                            opacity: .5;
                                        }
                                        .btn-toggle > .handle {
                                            position: absolute;
                                            top: 0.1875rem;
                                            left: 0.1875rem;
                                            width: 1.125rem;
                                            height: 1.125rem;
                                            border-radius: 1.125rem;
                                            background: #fff;
                                            transition: left .25s;
                                        }
                                        .btn-toggle.active {
                                            transition: background-color .25s;
                                        }
                                        .btn-toggle.active {
                                            background-color: #0d6efd !important;
                                        }
                                        .btn-toggle.active > .handle {
                                            left: 1.6875rem;
                                            transition: left .25s;
                                        }
                                        .btn-toggle.active:before {
                                            opacity: .5;
                                        }
                                        .btn-toggle.active:after {
                                            opacity: 1;
                                        }
                                        
                                    </style>
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-sm-5">
                                                <input type="hidden" id="hiddenBloqueado" name="btnBloqueado" value="1">
                                                <button type="button" class="btn btn-toggle" data-bs-toggle="button" aria-pressed="false" autocomplete="off" id="btnBloqueado">
                                                    <div class="handle"></div>
                                                </button>
                                                <script>
                                                    const btn = document.getElementById("btnBloqueado");
                                                    const hidden = document.getElementById("hiddenBloqueado");

                                                    btn.addEventListener("click", () => {
                                                        const pressed = btn.getAttribute("aria-pressed") === "true";
                                                        hidden.value = pressed ? "0" : "1";
                                                    });
                                                </script>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="anoLectivo" name="anoLetivo" placeholder="anoLetivo" value="<%= fuc[0].anoLetivoFuc %>"readonly >
                                    <label for="anoLetivo">Ano Letivo:</label>
