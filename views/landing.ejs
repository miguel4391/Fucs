			<table>
				<thead>
					<tr><th colspan="5">Hora de contacto (%)</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>Presenciais:</td>
						<td><input type="text" class="form-control form-control-sm" id="hrsPres" name="hrsPres" readonly><td>
						<td>À distância:</td>
						<td><input type="text" class="form-control form-control-sm" id="hrsDist" name="hrsDist" readonly><td>
					</tr>
				</tbody>
			</table>
			<script>
			document.querySelectorAll('.integer-only').forEach(input => {

				input.addEventListener('input', function() {

					this.value = this.value.replace(/[^0-9]/g, '');

				});

			});
			document.querySelectorAll('.horas').forEach(input => {

				input.addEventListener('keydown', function(e) {

					if (
						e.key === '.' ||
						e.key === ',' ||
						e.key === 'e' ||
						e.key === 'E' ||
						e.key === '-' ||
						e.key === '+'
					) {
						e.preventDefault();
					}

				});

			});

			function toNumber(value) {
				return parseFloat(value) || 0;
			}

			function calcularHoras() {

				// Horas presenciais (coluna 2)
				let totalContacto =
					toNumber(document.getElementById('hrsT').value) +
					toNumber(document.getElementById('hrsTp').value) +
					toNumber(document.getElementById('hrsPl').value) +
					toNumber(document.getElementById('hrsTc').value) +
					toNumber(document.getElementById('hrsS').value) +
					toNumber(document.getElementById('hrsE').value) +
					toNumber(document.getElementById('hrsOt').value) +
					toNumber(document.getElementById('hrsO').value);

				// Horas assíncronas (coluna 3)
				let totalAss =
					toNumber(document.getElementById('hrsAssT').value) +
					toNumber(document.getElementById('hrsAssTp').value) +
					toNumber(document.getElementById('hrsAssPl').value) +
					toNumber(document.getElementById('hrsAssTc').value) +
					toNumber(document.getElementById('hrsAssS').value) +
					toNumber(document.getElementById('hrsAssE').value) +
					toNumber(document.getElementById('hrsAssOt').value) +
					toNumber(document.getElementById('hrsAssO').value);

				// Horas síncronas à distância (coluna 4)
				let totalSinc =
					toNumber(document.getElementById('hrsSincT').value) +
					toNumber(document.getElementById('hrsSincTp').value) +
					toNumber(document.getElementById('hrsSincPl').value) +
					toNumber(document.getElementById('hrsSincTc').value) +
					toNumber(document.getElementById('hrsSincS').value) +
					toNumber(document.getElementById('hrsSincE').value) +
					toNumber(document.getElementById('hrsSincOt').value) +
					toNumber(document.getElementById('hrsSincO').value);

				// Totais
				document.getElementById('hrsTot').value = totalContacto;
				document.getElementById('hrsAssTot').value = totalAss;
				document.getElementById('hrsSincTot').value = totalSinc;

				// Percentagens
				let totalGeral = totalContacto + totalAss + totalSinc;

				if (totalGeral > 0) {

					let percPresencial =
						(totalContacto / totalGeral) * 100;

					let percDistancia =
						((totalAss + totalSinc) / totalGeral) * 100;

					document.getElementById('hrsPres').value =
						percPresencial.toFixed(2);

					document.getElementById('hrsDist').value =
						percDistancia.toFixed(2);

				} else {

					document.getElementById('hrsPres').value = '';
					document.getElementById('hrsDist').value = '';

				}
			}

			// Adiciona o evento a todos os campos de horas
			document.querySelectorAll('input[id^="hrs"]').forEach(input => {

				if (
					input.id !== 'hrsTot' &&
					input.id !== 'hrsAssTot' &&
					input.id !== 'hrsSincTot' &&
					input.id !== 'hrsPres' &&
					input.id !== 'hrsDist'
				) {
					input.addEventListener('input', calcularHoras);
				}

			});

			// cálculo inicial
			calcularHoras();

			</script>
		</div>
	</div>
