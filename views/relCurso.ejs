        <div class="container border ">
            <div class="row m-3">
                <h4>3. SÍNTESE DA APRECIAÇÃO GLOBAL DO QUESTIONÁRIO DA MONITORIZAÇÃO DO ENSINO E APRENDIZAGEM</h4>
            </div>
            <div class="row m-3">
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbNrInscri" name="tbNrInscri" placeholder="NrAlunosInscritosCE" value="<%= ce[0].NrInscritos %>" <% if(ce[0].finalizado==1){%> readonly <% } %>>
                        <label for="tbNrInscri">Nº Inscritos no CE</label>
                    </div>
                </div>
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbNrInscriUC" name="tbNrInscriUC" placeholder="NrAlunosInscritosUC" value="<%= ce[0].nrIscritUC %>" <% if(ce[0].finalizado==1){%> readonly <% } %>>
                        <label for="tbNrInscriUC">Nº Inscritos em UC</label>
                    </div>
                </div>
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbNrResp1Sem" name="tbNrResp1Sem" placeholder="NrRespostasPrimeiroSemestre" onkeyup="doAverage1sem();" value="<%= ce[0].NrResp1Sem %>" <% if(ce[0].finalizado==1){%> readonly <% } %>>
                        <label for="tbNrResp1Sem">Nº Respostas 1º Sem</label>
                    </div>
                </div>
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbPerResp1Sem" name="tbPerResp1Sem" placeholder="PercentagemRespostasPrimeiroSemestre" value="<%= ce[0].PercResp1Sem %>" <% if(ce[0].finalizado==1){%> readonly <% } %> readonly>
                        <label for="tbPerResp1Sem">% Respostas 1º Sem</label>
                    </div>
                </div>
                <script>
                    function doAverage1sem(){
                        let isDecimal = v => /^[+-]?(\d+(\.\d*)?|\.\d+)$/.test(v);
                        let nrInscri = '';
                        let inscriUC = '';
                        let nrResp = '';
                        nrInscri = $('#tbNrInscri').val().trim();
                        inscriUC = $('#tbNrInscriUC').val().trim();
                        nrResp = $('#tbNrResp1Sem').val().trim();
                        if(!nrInscri)nrInscri = "0";
                        if(!inscriUC)inscriUC = "0";
                        if(!nrResp)nrResp = "0";
                        if(isDecimal(nrInscri) && isDecimal(inscriUC) && isDecimal(nrResp)){            
                            let total = parseFloat(nrInscri) + parseFloat(inscriUC);
                            let nrResp = $('#tbNrResp1Sem').val().trim();
                        
                            $('#tbPerResp1Sem').val((nrResp / total * 100).toFixed(2));                              
                        }
                    }
                </script>
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbNrResp2Sem" name="tbNrResp2Sem" placeholder="NrRespostasSegundoSemestre" onkeyup="doAverage2sem();" value="<%= ce[0].NrResp2Sem %>" <% if(ce[0].finalizado==1){%> readonly <% } %> >
                        <label for="tbNrResp2Sem">Nº Respostas 2º Sem</label>
                    </div>
                </div>
                <div class="col-xs-6 col-md-4 col-xl-2">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbPerResp2Sem" name="tbPerResp2Sem" placeholder="PercentagemRespostasSegundoSemestre" value="<%= ce[0].PercResp2Sem %>" <% if(ce[0].finalizado==1){%> readonly <% } %> readonly>
                        <label for="tbPerResp2Sem">% Respostas 2º Sem</label>
                    </div>
                </div>
                <script>
                    function doAverage2sem(){
                        let isDecimal = v => /^[+-]?(\d+(\.\d*)?|\.\d+)$/.test(v);
                        let nrInscri = '';
                        let inscriUC = '';
                        let nrResp = '';
                        nrInscri = $('#tbNrInscri').val().trim();
                        inscriUC = $('#tbNrInscriUC').val().trim();
                        nrResp = $('#tbNrResp2Sem').val().trim();
                        if(!nrInscri)nrInscri = "0";
                        if(!inscriUC)inscriUC = "0";
                        if(!nrResp)nrResp = "0";
                        if(isDecimal(nrInscri) && isDecimal(inscriUC) && isDecimal(nrResp)){            
                            let total = parseFloat(nrInscri) + parseFloat(inscriUC);
                            let nrResp = $('#tbNrResp2Sem').val().trim();
                        
                            $('#tbPerResp2Sem').val((nrResp / total * 100).toFixed(2));                              
                        }
                    }
                </script>
            </div>
        </div>
        <div class="container border ">
            <div class="row m-3">
                <table class="table table-striped table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>AVALIAÇÃO DAS UNIDADES CURRICULARES</th>
                            <th>MÉDIA (ANO LETIVO)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Clareza na definição dos objetivos da unidade curricular</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbAvgClareza" name="tbAvgClareza" placeholder="Clareza" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].Clareza %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Grau de interesse da matéria lecionada</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbAvgGrauInt" name="tbAvgGrauInt" placeholder="Grau Interesse" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].Interesse %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Articulação com as outras unidades curriculares do curso</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbArticUC" name="tbArticUC" placeholder="Articulação entre UCs" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].ArticulaOutUC %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Grau de dificuldade da matéria</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbAvgGrauDific" name="tbAvgGrauDific" placeholder="Grau Dificuldade" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].Dificuld %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Relação entre conteúdo e carga horária</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbRelCargaConte" name="tbRelCargaConte" placeholder="Relação Conteúdo Horário" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].RelConteudo %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Articulação entre aulas teóricas e práticas (quando aplicável)</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbRelTeoPrat" name="tbRelTeoPrat" placeholder="Relação Teórico-praticas" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].ArticulTeoPratic %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Disponibilidade da bibliografia indicada</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbBiblioDisp" name="tbBiblioDisp" placeholder="Disponibilidade Bibliografia" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].DispBiblio %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Clareza dos elementos de avaliação, face aos objetivos da unidade curricular</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbElemAval" name="tbElemAval" placeholder="Clareza Avaliação" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].ClarezaElemAval %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Disponibilidade e adequação dos meios técnicos utilizados (quando aplicável)</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbDispMeios" name="tbDispMeios" placeholder="Disponibilização Meios" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].DisponMeios %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Articulação da unidade curricular com a realidade atual</td>
                            <td><input type="text" inputmode="decimal" class="form-control form-control-sm" id="tbUCMundoReal" name="tbUCMundoReal" placeholder="Articulação UC - Realidade" oninput="validarDecimal(this); doAverage();" value="<%= ce[0].ArticulaRealidade %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                        </tr>
                        <tr>
                            <td>Média Geral</td>
                            <td><input type="text" class="form-control form-control-sm" id="tbAvgGreal" name="tbAvgGreal" placeholder="Média" value="<%= ce[0].MediaInq %>" readonly></td>
                            <script>
                                function validarDecimal(input) {
                                    // Converte vírgula em ponto
                                    input.value = input.value.replace(/,/g, '.');

                                    // Remove tudo o que não seja número ou ponto
                                    input.value = input.value.replace(/[^0-9.]/g, '');

                                    // Garante que existe no máximo um ponto decimal
                                    const partes = input.value.split('.');

                                    if (partes.length > 2) {
                                        input.value = partes[0] + '.' + partes.slice(1).join('');
                                    }
                                }

                                function doAverage(){
                                    let sum = 0, count = 0;
                                    let n1 = $('#tbAvgClareza').val().trim();
                                    let n2 = $('#tbAvgGrauInt').val().trim();
                                    let n3 = $('#tbArticUC').val().trim();
                                    let n4 = $('#tbAvgGrauDific').val().trim();
                                    let n5 = $('#tbRelCargaConte').val().trim();
                                    let n6 = $('#tbRelTeoPrat').val().trim();
                                    let n7 = $('#tbBiblioDisp').val().trim();
                                    let n8 = $('#tbElemAval').val().trim();
                                    let n9 = $('#tbDispMeios').val().trim();
                                    let n10 = $('#tbUCMundoReal').val().trim();
                                    
                                    let isDecimal = v => /^[+-]?(\d+(\.\d*)?|\.\d+)$/.test(v);

                                    if(isDecimal(n1)){
                                        sum += parseFloat(n1);
                                        count ++;
                                    }
                                    if(isDecimal(n2)){
                                        sum += parseFloat(n2);
                                        count ++;
                                    }
                                    if(isDecimal(n3)){
                                        sum += parseFloat(n3);
                                        count ++;
                                    }
                                    if(isDecimal(n4)){
                                        sum += parseFloat(n4);
                                        count ++;
                                    }
                                    if(isDecimal(n5)){
                                        sum += parseFloat(n5);
                                        count ++;
                                    }
                                    if(isDecimal(n6)){
                                        sum += parseFloat(n6);
                                        count ++;
                                    }
                                    if(isDecimal(n7)){
                                        sum += parseFloat(n7);
                                        count ++;
                                    }
                                    if(isDecimal(n8)){
                                        sum += parseFloat(n8);
                                        count ++;
                                    }
                                    if(isDecimal(n9)){
                                        sum += parseFloat(n9);
                                        count ++;
                                    }
                                    if(isDecimal(n10)){
                                        sum += parseFloat(n10);
                                        count ++;
                                    }
                                    if (count > 0) {
                                        $('#tbAvgGreal').val((sum / count).toFixed(2));
                                    } else {
                                        $('#tbAvgGreal').val('Sem valores decimais.');
                                    }
                                }
                            </script>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="container border ">
