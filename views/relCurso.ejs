                        <tr>
                            <td><input type="text" class="form-control" id="tbNrIncriUltAno" name="tbNrIncriUltAno" onkeyup="doAverageDiplo()" value="<%= ce[0].NrIncriUltAno %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                            <td><input type="text" class="form-control" id="tbNrDiplom" name="tbNrDiplom" onkeyup="doAverageDiplo()" value="<%= ce[0].NrDiplom %>" <% if(ce[0].finalizado==1){%> readonly <% } %>></td>
                            <td><input type="text" class="form-control" id="tbTxAprov" name="tbTxAprov" value="<%= ce[0].TxAprov %>"  readonly ></td>
                        </tr>
                        <script>
                            function doAverageDiplo(){
                                let isDecimal = v => /^[+-]?(\d+(\.\d*)?|\.\d+)$/.test(v);
                                let tbNrIncriUltAno = '';
                                let tbNrDiplom = '';
                                let tbTxAprov = '';
                                tbNrIncriUltAno = $('#tbNrIncriUltAno').val().trim();
                                tbNrDiplom = $('#tbNrDiplom').val().trim();
                                
                                if(!tbNrIncriUltAno)tbNrIncriUltAno = "0";
                                if(!tbNrDiplom)tbNrDiplom = "0";
                                if(isDecimal(tbNrIncriUltAno) && isDecimal(tbNrDiplom)){            
                                    $('#tbTxAprov').val((tbNrDiplom / tbNrIncriUltAno * 100).toFixed(2));                              
                                }
                            }
                        </script>
