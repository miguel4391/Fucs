                        <label for="tbDtaSophUC">Data Consulta Sophia de Inscrições</label>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 col-xl-3">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control form-control-sm" id="tbDtaSophDiplom" name="tbDtaSophDiplom" placeholder="DataSophDiplom" value="<%= ce[0].DataSophDiplom %>" <% if(ce[0].finalizado==1){%> readonly <% } %>>
                        <label for="tbDtaSophUC">Data Consulta Sophia de Diplomados</label>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 col-xl-3">
